# Copy to .env — never commit .env. Client secret stays on the server only.

# Local ports
PORT=3001
VITE_DEV_PORT=5173
# Public origin used by monday item-view + Entra redirect (tunnel HTTPS URL in real use)
PUBLIC_BASE_URL=http://localhost:5173

# Microsoft Entra (Azure AD) app registration
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret
# Must match an Entra redirect URI exactly (tunnel URL when testing in monday)
ENTRA_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback

# Optional: default monday context when running outside the item view (local browser smoke)
# DEV_ACCOUNT_ID=1
# DEV_USER_ID=1

# Token file store (local-first; monday-code Secure Storage later)
TOKEN_STORE_PATH=.tokens/microsoft-tokens.json

# CORS / cookie (same-site via Vite proxy in local-first)
SESSION_SECRET=change-me-to-a-long-random-string
